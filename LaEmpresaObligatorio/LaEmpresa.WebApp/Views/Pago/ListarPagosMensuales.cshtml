@using LaEmpresa.LogicaAplicacion.DTOs
@using LaEmpresa.LogicaNegocio.Entidades
@model IEnumerable<LaEmpresa.LogicaAplicacion.DTOs.PagoDTO>

@{
    ViewData["Title"] = "Listar Pagos Mensuales";
}

<h1>ListarPagosMensuales</h1>
@if (!string.IsNullOrEmpty(ViewBag.Error))
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}
<form action="ListarPagosMensuales" method="post">
    <div class="form-group">
        <label class="control-label" for="mes">Ingrese un mes:</label>
        <input type="number" name="mes" class="form-group" min="1" max="12" id="mes" />
        <br />
        <label class="control-label" for="anio">Ingrese un año:</label>
        <input type="number" name="anio" class="form-group" min="1900" max="2100" id="anio" />
        <br />
    </div>
    <div class="form-group">
        <input type="submit" value="Filtrar" class="btn btn-primary" />
    </div>
</form>
@if(Model != null && Model.Any())
{
 <table class="table">
        <thead>
            <tr>
                <th>
                    MetodoPago
                </th>
                <th>
                    Descripcion
                </th>
                <th>
                    Monto
                </th>
                <th>
                    Saldo Pendiente
                </th>
                <th>
                    Fecha Desde
                </th>
                <th>
                    Fecha Hasta
                </th>
                <th>
                    Fecha De Pago
                </th>
                <th>
                    Nro de Recibo
                </th>
            </tr>
        </thead>
        <tbody> 
                @foreach (PagoDTO pago in Model)
            {
              <tr>           
               
                    <td>
                        @pago.MetodoPago
                    </td>
                    <td>
                        @pago.Descripcion
                    </td>
                    <td>
                        @pago.Monto
                    </td>
                    <td>
                        @pago.SaldoPendiente
                    </td>
                    @if (pago is Unico)
                    {
                        <td></td>
                        <td></td>
                        <td>
                            @pago.FechaDePago
                        </td>
                        <td>
                            @pago.NroRecibo
                        </td>
                    }
                    @if (pago is Recurrente)
                    {
                        <td>
                            @pago.FechaDesde
                        </td>
                        <td>
                            @pago.FechaHasta
                        </td>
                    }
                </tr>
                  }
        </tbody>
 </table>
}
