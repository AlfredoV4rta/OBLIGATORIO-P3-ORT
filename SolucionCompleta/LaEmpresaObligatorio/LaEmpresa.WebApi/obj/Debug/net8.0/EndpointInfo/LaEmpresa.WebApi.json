      "get": {
        "tags": [
          "Pago"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Pago/{id}": {
      "get": {
        "tags": [
          "Pago"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Pago/{mes}/{anio}": {
      "get": {
        "tags": [
          "Pago"
        ],
        "parameters": [
          {
            "name": "mes",
