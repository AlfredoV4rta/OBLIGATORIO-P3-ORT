{
  "openapi": "3.0.1",
  "info": {
    "title": "LaEmpresa.WebApi",
    "version": "1.0"
  },
  "paths": {
    "/api/Login/login": {
      "post": {
        "tags": [
          "Login"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Pago": {
      "get": {
        "tags": [
          "Pago"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Pago/{id}": {
      "get": {
        "tags": [
          "Pago"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Pago/{mes}/{anio}": {
      "get": {
        "tags": [
          "Pago"
        ],
        "parameters": [
          {
            "name": "mes",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "anio",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Pago/usuario/{monto}": {
      "get": {
        "tags": [
          "Pago"
        ],
        "parameters": [
          {
            "name": "monto",
            "in": "path",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Rol": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "UsuarioDTO": {
        "required": [
          "apellido",
          "contrasenia",
          "email",
          "idEquipo",
          "nombre",
          "rol"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "idEquipo": {
            "type": "integer",
            "format": "int32"
          },
          "email": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "contrasenia": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "nombre": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "apellido": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "rol": {
            "$ref": "#/components/schemas/Rol"
          },
          "token": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}